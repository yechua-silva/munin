# ============================================================================
# Munin — Industrial Vision Agent | Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# --- VLM Backend ---
# Backend de inferencia VLM: "fireworks" (cloud, interim) | "amd" (on-premise, target)
MUNIN_VLM_BACKEND=fireworks

# --- Fireworks AI (interim, cloud) ---
# Obtener en: https://fireworks.ai/settings/api-keys
MUNIN_FIREWORKS_API_KEY=fw-your-api-key-here
# Modelo VLM serverless en Fireworks (Qwen3-VL-8B-Instruct recommended)
MUNIN_FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6

# --- AMD vLLM (target, on-premise) ---
# Descomentar cuando AMD MI300X esté disponible
# MUNIN_VLM_BACKEND=amd
# MUNIN_AMD_VLLM_ENDPOINT=http://localhost:8000/v1
# MUNIN_AMD_MODEL=InternVL2-8B

# --- YOLO Detector ---
# Ruta al modelo YOLOv8n PPE fine-tuned (EPP: gloves, vest, helmet, etc.)
MUNIN_YOLO_MODEL_PATH=recursos/datasets/model-weights/yolov8n_ppe_best.pt
# Ruta al modelo YOLOv8n COCO base (detección de personas). Ultralytics descarga automáticamente si no existe.
MUNIN_YOLO_COCO_MODEL_PATH=yolov8n.pt
# Threshold de confianza (0.0-1.0). Solo detecciones > threshold se reportan
MUNIN_YOLO_CONFIDENCE_THRESHOLD=0.6
# Dispositivo: "cuda:0" (GPU AMD/NVIDIA) | "cpu" (desarrollo sin GPU)
MUNIN_YOLO_DEVICE=cpu

# --- Pipeline ---
# FPS objetivo de extracción de frames
MUNIN_FRAME_RATE=25
# Frames consecutivos con violación antes de invocar VLM (reduce falsos positivos)
MUNIN_MIN_CONSECUTIVE_FRAMES=3
# Timeout para llamadas VLM en segundos
MUNIN_VLM_BUSY_TIMEOUT=30.0

# --- Knowledge Base ---
# Ruta al archivo JSON con artículos DS 132
MUNIN_DS132_KB_PATH=./knowledge/ds132_kb.json
# Ruta al archivo JSON con configuración de zonas
MUNIN_ZONES_CONFIG_PATH=./knowledge/zones.json

# --- Logging ---
# Nivel de logging: DEBUG | INFO | WARNING | ERROR
MUNIN_LOG_LEVEL=INFO
