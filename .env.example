# ============================================================================
# Munin v4 — Environment Configuration Template
# ============================================================================
# Copy to .env and adjust values for your deployment:
#   cp .env.example .env
#
# All variables use MUNIN_ prefix (pydantic_settings).
#
# Deployment: AMD MI300X droplet (129.212.177.29)
# Container: rocm (ROCm 7.2.4)
# ============================================================================

# --- VLM Backend ---
# Backend: "amd" (on-premise MI300X via vLLM) or "fireworks" (cloud, interim)
MUNIN_VLM_BACKEND=amd

# AMD MI300X via vLLM (on-premise, 100% local)
MUNIN_AMD_VLLM_ENDPOINT=http://localhost:8000/v1
# ADR-032: served-model-name InternVL2-8B en vLLM
MUNIN_AMD_MODEL=InternVL2-8B

# Fireworks AI (cloud interim — fallback only)
MUNIN_FIREWORKS_API_KEY=your-api-key-here
MUNIN_FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6

# VLM settings
MUNIN_VLM_BUSY_TIMEOUT=300.0
MUNIN_VLM_MAX_TOKENS=8192

# --- YOLO Models ---
# COCO model for person detection (auto-downloaded by ultralytics)
MUNIN_YOLO_COCO_MODEL_PATH=yolov8n.pt

# PPE model (6-class, legacy mode)
MUNIN_YOLO_MODEL_PATH=recursos/datasets/model-weights/yolov8n_ppe_best.pt

# Construction-PPE fine-tuned model (11-class, dual_class mode)
# Ruta absoluta en el droplet AMD MI300X
MUNIN_YOLO_PPE_MODEL_PATH=/scratch/runs/detect/train/weights/best.pt

# YOLO inference settings
MUNIN_YOLO_CONFIDENCE_THRESHOLD=0.6
MUNIN_YOLO_DEVICE=cuda:0
MUNIN_YOLO_IMGSZ=640

# --- Pipeline Settings ---
MUNIN_FRAME_RATE=25
MUNIN_MIN_CONSECUTIVE_FRAMES=3

# --- Compliance Mode (v3) ---
# "legacy" = TwoModelDetector (COCO + PPE 6-class)
# "dual_class" = SingleModelDetector (Construction-PPE 11-class)
MUNIN_COMPLIANCE_MODE=legacy

# YOLO stream mode (stream=True for memory-efficient video processing)
MUNIN_YOLO_STREAM_MODE=false

# --- Frame Resize for VLM (ADR-016) ---
# Redimensionar frames antes de enviar a VLM para reducir latencia
MUNIN_FRAME_RESIZE_WIDTH=640
MUNIN_FRAME_RESIZE_HEIGHT=480

# --- Prompt Caching (ADR-015) ---
# Session ID for Fireworks prompt caching (x-session-affinity header)
MUNIN_PROMPT_CACHE_SESSION_ID=munin-session

# --- SinglePass default (CP4) ---
# true = SinglePassAgent como default (v4), false = 3-agent secuencial (v3)
MUNIN_USE_SINGLE_PASS=true

# --- Multi-cámara (Track C) ---
# Habilitar pipeline multi-cámara con VLM queue
MUNIN_MULTI_CAMERA_ENABLED=false

# JSON con lista de fuentes de cámara
# Ejemplo:
#   MUNIN_MULTI_CAMERA_SOURCES=[{"camera_id":"cam01","source":"/path/to/video.mp4","zone_id":"extraccion","fps":25,"resolution":[640,480]}]
MUNIN_MULTI_CAMERA_SOURCES=

# VLM Queue settings (Track C)
MUNIN_VLM_QUEUE_MAX_SIZE=10
MUNIN_VLM_QUEUE_WORKERS=1
# Coalescing: frames consecutivos misma violación para skip VLM
MUNIN_VLM_COALESCE_FRAMES=30
# Aging: segundos antes de subir prioridad de un request en cola
MUNIN_VLM_AGING_SECONDS=15

# --- Knowledge Base ---
# Ruta al archivo JSON con artículos DS 132
MUNIN_DS132_KB_PATH=./knowledge/ds132_kb.json
# Ruta al archivo JSON con configuración de zonas mineras
MUNIN_ZONES_CONFIG_PATH=./knowledge/zones.json

# --- Logging ---
# Nivel de logging: DEBUG | INFO | WARNING | ERROR
MUNIN_LOG_LEVEL=INFO
